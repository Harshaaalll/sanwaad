# ---------------------------------------------------------------------------
# Sanwaad. Everything here is optional: with no keys at all the graph runs in
# offline mode and the demo still completes end to end.
# ---------------------------------------------------------------------------

# LLM — Gemini Developer API (simplest) ...
GOOGLE_API_KEY=

# ... or Vertex, which is where explicit context caching pays off in production
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=

# Model tiers. Triage runs on every inbound item, so it stays on the cheap one.
SANWAAD_MODEL_TRIAGE=gemini-2.5-flash-lite
SANWAAD_MODEL_DRAFT=gemini-2.5-flash
SANWAAD_MODEL_REASONING=gemini-2.5-pro
SANWAAD_VOICE_MODEL=gemini-2.5-flash

# Voice leg (only needed to place an actual call)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
MURF_API_KEY=
MURF_VOICE_ID=en-IN-aditya
MURF_MODEL=FALCON

# Retrieval runs locally on ONNX — no key, no per-token cost.
SANWAAD_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Listener. The brand as people actually write it — misspellings matter more
# than the canonical form, because nobody checks their spelling while angry.
# Channels are polled in order; a dead one is logged and skipped, never fatal.
SANWAAD_BRAND=NimbusPay
SANWAAD_BRAND_ALIASES=NimbusPay,Nimbus Pay,Nimbuspay,nimbus,निंबस
SANWAAD_CHANNELS=mock

# Reddit connector. Read access needs only a script-type app.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sanwaad/0.1
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDITS=india+IndiaInvestments
REDDIT_QUERY=upi OR wallet OR refund

# Master switch for writing to a real platform. Leave off until you mean it.
SANWAAD_ALLOW_POSTING=false

SANWAAD_PORT=7870
INR_PER_USD=84.0
